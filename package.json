{
  "private": true,
  "name": "over9000games",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "postinstall": "npm run build",
    "build:client": "cd src/client && vite build",
    "build:server": "cd src/server && vite build",
    "build": "npm run build:client && npm run build:server",
    "deploy": "npm run build && devvit upload",
    "dev": "concurrently -k -p \"[{name}]\" -n \"CLIENT,SERVER,DEVVIT\" -c \"blue,green,magenta\" \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:devvit\"",
    "dev:client": "cd src/client && vite build --watch",
    "dev:devvit": "dotenv -e .env -- devvit playtest",
    "dev:server": "cd src/server && vite build --watch",
    "login": "devvit login",
    "launch": "npm run build && npm run deploy && devvit publish",
    "type-check": "tsc --build",
    "testbed": "npm run build:client && node --import ./src/testbed/loader.js src/testbed/server.js",
    "testbed:dev": "concurrently -k -n \"CLIENT,SERVER\" -c \"blue,green\" \"npm run dev:client\" \"node --import ./src/testbed/loader.js --watch src/testbed/server.js\""
  },
  "dependencies": {
    "@devvit/web": "0.12.0",
    "devvit": "0.12.0",
    "express": "5.1.0",
    "quickjs-emscripten": "^0.31.0",
    "vite-plugin-wasm": "^3.5.0"
  },
  "devDependencies": {
    "@types/express": "5.0.1",
    "concurrently": "9.1.2",
    "dotenv": "^16.4.5",
    "dotenv-cli": "8.0.0",
    "redis": "^4.7.0",
    "typescript": "5.8.2",
    "vite": "6.2.4"
  }
}
